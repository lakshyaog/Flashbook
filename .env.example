# ==============================================================================
# FlashBook AI — Environment Configuration Example
# ==============================================================================
# IMPORTANT: Never commit actual private keys or secrets to version control.
# Copy this file to .env and configure for your target environment.

# --- NETWORK & RPC CONFIGURATION ---
# Sepolia Chain ID: 11155111 | Local Anvil Chain ID: 31337
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# For Sepolia, use Infura, Alchemy, or public RPC:
# RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# RPC_URL=https://rpc.sepolia.org

# --- SMART CONTRACT ADDRESSES ---
# Default addresses correspond to local deterministic deployment via Deploy.s.sol
WETH_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
USDT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
EXCHANGE_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# --- BACKEND SERVER ---
PORT=3001

# --- AI-ASSISTED MARKET MAKER CONFIGURATION ---
# When true, the AI MM records decisions and quotes without broadcasting transactions
MM_DRY_RUN=true
MM_ENABLED=true
MM_POLL_INTERVAL_MS=4000
MM_TARGET_INVENTORY_WETH=10.0
MM_MAX_ORDER_SIZE_WETH=0.5
MM_MIN_ORDER_SIZE_WETH=0.01
MM_BASE_SPREAD_BPS=30
MM_GAMMA=0.1
MM_MAX_PRICE_DEV_BPS=500
# Private key for AI MM in LIVE mode (funded with testnet ETH & tokens)
# Default is Anvil Account #1 (NEVER use with real funds)
MM_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# --- FRONTEND (Vite Environment Variables) ---
VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org
VITE_SEPOLIA_EXCHANGE=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
VITE_SEPOLIA_WETH=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_SEPOLIA_USDT=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
